# Copy to .env.local at the repo root (never commit it). All workspaces read this one file.

# ---------- Meta models ----------
# Which server answers model calls: META_API | BASETEN | MODAL
# FAKE = dev-only test stub (canned responses, no model, no network). Refused when NODE_ENV=production.
AI_PROVIDER=META_API

# Meta Model API (https://dev.meta.ai) — Muse Spark
MODEL_API_KEY=
# Optional overrides
# META_API_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3

# District-hosted mode: Muse Spark Open on Baseten
BASETEN_API_KEY=
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_MODEL=meta-models/muse-spark-open-1026

# District-hosted mode: Muse Spark Open on our own Modal deployment
MODAL_BASE_URL=
MODAL_API_KEY=
# MODAL_MODEL=muse-spark-open

# Hard cap on paid model calls per UTC day, in USD (default 5). When reached, every AI
# feature pauses until the next day. 0 pauses AI entirely. Counts META_API/BASETEN/MODAL calls.
DAILY_SPEND_CAP_USD=5

# ---------- Teacher dashboard (demo-grade auth) ----------
# Passcode the teacher types to sign in.
TEACHER_PASSCODE=
# 32+ random characters used to sign the session cookie, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ---------- Extension ----------
# Where the side panel calls the API. Baked into the build and the manifest's host_permissions.
VITE_API_BASE_URL=http://localhost:3000

# ---------- Supabase ----------
# Runtime connection: Supabase "Transaction pooler" string (port 6543)
DATABASE_URL=
# Migrations: Supabase "Session pooler" string (port 5432). Falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=

# Storage for uploaded sources and audio (used from Day 2). Server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
